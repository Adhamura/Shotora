    <sys:String x:Key="LocMainTitle">Shotora</sys:String>
    <sys:String x:Key="LocMainHint1">გადასაღებად გამოიყენეთ სისტემური უჯრის ხატულა ან გლობალური ცხელი კლავიშები.</sys:String>
    <sys:String x:Key="LocMainHint2">ეს ფანჯარა არასავალდებულოა; დახურეთ და Shotora სისტემურ უჯრაში გააგრძელებს მუშაობას.</sys:String>

    <sys:String x:Key="LocAboutSubtitle">გადაღება – ანოტაცია – OCR – გაზიარება</sys:String>
    <sys:String x:Key="LocAboutDescription">Shotora არის თანამედროვე გუნდებისთვის შექმნილი ეკრანის გადაღებისა და ანოტაციის ფოკუსირებული ინსტრუმენტი. ის იღებს არეებს, ფანჯრებს ან სრულ ეკრანს, მყისიერად ამატებს ისრებს, ფიგურებს, ტექსტს, მონიშვნას, გაბუნდოვნებასა და პიქსელიზაციას და Tesseract-ის ან EasyOCR-ის საშუალებით ეკრანზე არსებულ ტექსტს რედაქტირებად ტექსტად გარდაქმნის — მთლიანად თქვენს მოწყობილობაზე. ცხელი კლავიშების, თემებისა და ერთი დაწკაპუნებით კოპირებისა და შენახვის წყალობით უკუკავშირი და დოკუმენტაცია სწრაფი, კონფიდენციალური და თანმიმდევრული რჩება.</sys:String>
    <sys:String x:Key="LocAboutLicense">ლიცენზია</sys:String>
    <sys:String x:Key="LocAboutAuthor">ავტორი და მხარდამჭერი</sys:String>
    <sys:String x:Key="LocAboutRole">უფროსი პროგრამული ინჟინერი / ტექნიკური ლიდერი</sys:String>
