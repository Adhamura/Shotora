    <sys:String x:Key="LocAboutRole">Inxhinier i lartë softueri / drejtues teknik</sys:String>
    <sys:String x:Key="LocAboutContact">Kontakti</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Për mbështetje, komente ose pyetje biznesi:</sys:String>

