    <sys:String x:Key="LocAboutAuthor">Avtor in vzdrževalec</sys:String>
    <sys:String x:Key="LocAboutRole">Višji programski inženir / tehnični vodja</sys:String>
    <sys:String x:Key="LocAboutContact">Stik</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Za podporo, povratne informacije ali poslovna vprašanja:</sys:String>

