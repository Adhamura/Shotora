    <sys:String x:Key="LocAboutAuthor">Tekijä</sys:String>
    <sys:String x:Key="LocAboutRole">Rooli</sys:String>
    <sys:String x:Key="LocAboutContact">Yhteystiedot</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Ota yhteyttä palautetta tai yhteistyötä varten.</sys:String>

