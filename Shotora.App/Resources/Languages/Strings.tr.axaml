    <sys:String x:Key="LocAboutRole">Kıdemli Yazılım Mühendisi / Teknik Lider</sys:String>
    <sys:String x:Key="LocAboutContact">İletişim</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Destek, geri bildirim veya iş talepleri için:</sys:String>

