    <sys:String x:Key="LocAboutRole">Loma</sys:String>
    <sys:String x:Key="LocAboutContact">Kontakts</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Raksti par atsauksmēm vai sadarbību.</sys:String>

