    <sys:String x:Key="LocAboutAuthor">Автор і супровідник</sys:String>
    <sys:String x:Key="LocAboutRole">Старший інженер-програміст / технічний керівник</sys:String>
    <sys:String x:Key="LocAboutContact">Контакти</sys:String>
    <sys:String x:Key="LocAboutContactIntro">З питань підтримки, відгуків або співпраці:</sys:String>

