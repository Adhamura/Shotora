    <!-- About -->
    <sys:String x:Key="LocAboutTitle">About Shotora</sys:String>
    <sys:String x:Key="LocAboutSubtitle">Capture - Annotate - OCR - Ship</sys:String>
    <sys:String x:Key="LocAboutDescription">Shotora is a focused visual capture and intelligence assistant for modern teams. It streamlines grabbing regions, windows, or full screens, applies blur/pixelate/highlight annotations instantly, and converts on-screen text to structured content via Tesseract or EasyOCR. With hotkeys, theming, offline tessdata, and one-click copy/save/upload, it keeps feedback loops and documentation fast, secure, and consistent.</sys:String>
    <sys:String x:Key="LocAboutVersion">Version</sys:String>
    <sys:String x:Key="LocAboutLicense">License</sys:String>
    <sys:String x:Key="LocAboutAuthor">Author &amp; Maintainer</sys:String>
    <sys:String x:Key="LocAboutRole">Senior Software Engineer / Technical Lead</sys:String>
    <sys:String x:Key="LocAboutContact">Contact</sys:String>
    <sys:String x:Key="LocAboutContactIntro">For support, feedback, or business inquiries:</sys:String>
    <sys:String x:Key="LocAboutCopyright">© 2025 Kazuki Kimura. Apache 2.0.</sys:String>
