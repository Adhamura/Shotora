    <sys:String x:Key="LocAboutAuthor">作者</sys:String>
    <sys:String x:Key="LocAboutRole">角色</sys:String>
    <sys:String x:Key="LocAboutContact">聯絡</sys:String>
    <sys:String x:Key="LocAboutContactIntro">歡迎聯繫提供回饋或合作。</sys:String>

