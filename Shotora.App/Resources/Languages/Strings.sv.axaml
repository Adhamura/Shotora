    <sys:String x:Key="LocAboutAuthor">Upphovsperson och underhållare</sys:String>
    <sys:String x:Key="LocAboutRole">Senior mjukvaruingenjör / teknisk ledare</sys:String>
    <sys:String x:Key="LocAboutContact">Kontakt</sys:String>
    <sys:String x:Key="LocAboutContactIntro">För support, feedback eller affärsförfrågningar:</sys:String>

