    <sys:String x:Key="LocAboutAuthor">Höfundur og umsjónarmaður</sys:String>
    <sys:String x:Key="LocAboutRole">Yfirhugbúnaðarverkfræðingur / tæknilegur leiðtogi</sys:String>
    <sys:String x:Key="LocAboutContact">Tengiliður</sys:String>
    <sys:String x:Key="LocAboutContactIntro">Fyrir aðstoð, endurgjöf eða viðskiptafyrirspurnir:</sys:String>

