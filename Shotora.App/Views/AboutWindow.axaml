<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:viewModels="clr-namespace:Shotora.App.Services.ViewModels;assembly=Shotora.App.Services"
        x:Class="Shotora.App.Views.AboutWindow"
        x:DataType="viewModels:AboutViewModel"
        Title="{DynamicResource LocAboutTitle}"
        Width="420"
        Height="650"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="avares://Shotora.App/Assets/Shotora.ico">
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="16"
            PointerPressed="ShellBorder_OnPointerPressed"
            PointerMoved="ShellBorder_OnPointerMoved"
            PointerExited="ShellBorder_OnPointerLeave">
        <Grid RowDefinitions="Auto,Auto,*,Auto">
            <StackPanel Grid.Row="0" Margin="0,0,0,10" Spacing="4">
                <TextBlock Text="{DynamicResource LocAboutTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           Foreground="{DynamicResource TextPrimaryBrush}" />
                <TextBlock Text="{DynamicResource LocAboutSubtitle}"
                           Foreground="{DynamicResource TextSecondaryBrush}" />
            </StackPanel>

            <Image Grid.Row="1"
                   Source="avares://Shotora.App/Assets/Shotora.png"
                   Height="96"
                   Stretch="Uniform"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,12" />

            <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="10">
                    <TextBlock Text="{DynamicResource LocAboutDescription}"
                               TextWrapping="Wrap"
                               Foreground="{DynamicResource TextPrimaryBrush}" />

                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource LocAboutVersion}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{Binding Version}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource LocAboutAuthor}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Kazuki Kimura"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource LocAboutRole}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="2">
                        <TextBlock Text="{DynamicResource LocAboutLicense}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="Apache License 2.0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource LocAboutLinks}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Cursor="Hand"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   TextDecorations="Underline"
                                   Tag="https://www.kazukikimura.com"
                                   PointerReleased="Link_OnPointerReleased">
                            <Run Text="{DynamicResource LocAboutWebsite}" />
                            <Run Text=": https://www.kazukikimura.com" />
                        </TextBlock>
                        <TextBlock Cursor="Hand"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   TextDecorations="Underline"
                                   Tag="https://www.linkedin.com/in/kazuki-kimura/"
                                   PointerReleased="Link_OnPointerReleased">
                            <Run Text="{DynamicResource LocAboutLinkedIn}" />
                            <Run Text=": https://www.linkedin.com/in/kazuki-kimura/" />
                        </TextBlock>
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="{DynamicResource LocAboutContact}"
                                   FontWeight="SemiBold"
                                   Foreground="{DynamicResource TextPrimaryBrush}" />
                        <TextBlock Text="{DynamicResource LocAboutContactIntro}"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <TextBlock Cursor="Hand"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   TextDecorations="Underline"
                                   Tag="mailto:kazuki.kimura.jp@gmail.com"
                                   PointerReleased="Link_OnPointerReleased">
                            <Run Text="kazuki.kimura.jp@gmail.com" />
                        </TextBlock>
                        <TextBlock Cursor="Hand"
                                   Foreground="{DynamicResource AccentPrimaryBrush}"
                                   TextDecorations="Underline"
                                   Tag="mailto:admin@kazukikimura.com"
                                   PointerReleased="Link_OnPointerReleased">
                            <Run Text="admin@kazukikimura.com" />
                        </TextBlock>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource LocAboutCopyright}"
                               FontSize="12"
                               Foreground="{DynamicResource TextSecondaryBrush}" />
                </StackPanel>
            </ScrollViewer>

            <StackPanel Grid.Row="3"
                        Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,12,0,0">
                <Button Content="{DynamicResource LocCommonClose}"
                        Width="90"
                        Click="Close_Click" />
            </StackPanel>
        </Grid>
    </Border>
</Window>