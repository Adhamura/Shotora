<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        xmlns:viewModels="clr-namespace:Shotora.App.Services.ViewModels;assembly=Shotora.App.Services"
        x:Class="Shotora.App.Views.AboutWindow"
        x:DataType="viewModels:AboutViewModel"
        Title="{DynamicResource LocAboutTitle}"
        Width="460"
        Height="640"
        MinWidth="380"
        MinHeight="420"
        CanResize="True"
        WindowStartupLocation="CenterOwner"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="avares://Shotora.App/Assets/Shotora.ico">
    <controls:DialogShell x:Name="Shell"
                          Title="{DynamicResource LocAboutTitle}"
                          Padding="0,12,0,0">
        <controls:DialogShell.Footer>
            <StackPanel Classes="dialog-actions">
                <Button Classes="accent"
                        Content="{DynamicResource LocCommonClose}"
                        IsDefault="True"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </controls:DialogShell.Footer>

        <ScrollViewer VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="16,0" Spacing="16">
                <!-- Product header -->
                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="16">
                    <Image Source="avares://Shotora.App/Assets/Shotora.png"
                           Width="72"
                           Height="72"
                           Stretch="Uniform"
                           VerticalAlignment="Center" />
                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                        <TextBlock Classes="display" Text="{DynamicResource LocMainTitle}" />
                        <TextBlock Classes="secondary" Text="{DynamicResource LocAboutSubtitle}" />
                    </StackPanel>
                </Grid>

                <TextBlock Text="{DynamicResource LocAboutDescription}"
                           TextWrapping="Wrap" />

                <!-- Details: label/value rows. VersionSection is the extension point for update checks. -->
                <Border Classes="card">
                    <StackPanel Grid.IsSharedSizeScope="True" Spacing="8">
                        <Grid x:Name="VersionSection">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AboutLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="label" Text="{DynamicResource LocAboutVersion}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1" Classes="secondary" Text="{Binding Version}" />
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AboutLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="label" Text="{DynamicResource LocAboutAuthor}" Margin="0,0,16,0" />
                            <StackPanel Grid.Column="1" Spacing="2">
                                <TextBlock Text="Kazuki Kimura" TextWrapping="Wrap" />
                                <TextBlock Classes="secondary" Text="{DynamicResource LocAboutRole}" />
                            </StackPanel>
                        </Grid>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" SharedSizeGroup="AboutLabel" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Classes="label" Text="{DynamicResource LocAboutLicense}" Margin="0,0,16,0" />
                            <TextBlock Grid.Column="1" Classes="secondary" Text="Apache License 2.0" />
                        </Grid>
                    </StackPanel>
                </Border>

                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{DynamicResource LocAboutLinks}" />
                    <HyperlinkButton NavigateUri="https://www.kazukikimura.com"
                                     ToolTip.Tip="https://www.kazukikimura.com"
                                     Content="{DynamicResource LocAboutWebsite}" />
                    <HyperlinkButton NavigateUri="https://www.linkedin.com/in/kazuki-kimura/"
                                     ToolTip.Tip="https://www.linkedin.com/in/kazuki-kimura/"
                                     Content="{DynamicResource LocAboutLinkedIn}" />
                </StackPanel>

                <StackPanel Spacing="4">
                    <TextBlock Classes="label" Text="{DynamicResource LocAboutContact}" />
                    <TextBlock Classes="secondary" Text="{DynamicResource LocAboutContactIntro}" />
                    <HyperlinkButton NavigateUri="mailto:kazuki.kimura.jp@gmail.com"
                                     Content="kazuki.kimura.jp@gmail.com" />
                    <HyperlinkButton NavigateUri="mailto:admin@kazukikimura.com"
                                     Content="admin@kazukikimura.com" />
                </StackPanel>

                <TextBlock Classes="caption"
                           Margin="0,0,0,4"
                           Text="{DynamicResource LocAboutCopyright}" />
            </StackPanel>
        </ScrollViewer>
    </controls:DialogShell>
</Window>
