<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        x:Class="Shotora.App.Views.OcrResultWindow"
        Title="{DynamicResource LocOcrResultTitle}"
        Width="480"
        Height="260"
        CanResize="False"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        ShowInTaskbar="False"
        Topmost="True">
    <controls:DialogShell Title="{DynamicResource LocOcrResultHint}">
        <controls:DialogShell.Footer>
            <StackPanel Classes="dialog-actions">
                <Button Content="{DynamicResource LocCommonClose}"
                        IsCancel="True"
                        Click="Close_Click" />
                <Button x:Name="CopyButton"
                        Classes="accent"
                        Content="{DynamicResource LocToolCopy}"
                        IsDefault="True"
                        Click="Copy_Click" />
            </StackPanel>
        </controls:DialogShell.Footer>

        <!-- "multiline" (not AcceptsReturn) so Enter reaches the default Copy button -->
        <TextBox x:Name="ResultBox"
                 Classes="multiline"
                 IsReadOnly="True"
                 AutomationProperties.Name="{DynamicResource LocOcrResultHint}" />
    </controls:DialogShell>
</Window>
