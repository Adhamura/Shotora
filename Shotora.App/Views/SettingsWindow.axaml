<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        xmlns:utilities="clr-namespace:Shotora.App.Models.Utilities;assembly=Shotora.App.Models"
        xmlns:loc="clr-namespace:Shotora.App.Models.Localization;assembly=Shotora.App.Models"
        xmlns:vm="clr-namespace:Shotora.App.Models.ViewModels;assembly=Shotora.App.Models"
        x:Class="Shotora.App.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="{DynamicResource LocSettingsTitle}"
        Width="680"
        Height="720"
        MinWidth="560"
        MinHeight="440"
        CanResize="True"
        WindowStartupLocation="CenterScreen"
        SystemDecorations="None"
        ExtendClientAreaToDecorationsHint="True"
        ExtendClientAreaChromeHints="PreferSystemChrome"
        Background="Transparent"
        TransparencyLevelHint="Transparent"
        Icon="avares://Shotora.App/Assets/Shotora.ico">
    <Window.Resources>
        <utilities:InverseBooleanConverter x:Key="InverseBool" />
    </Window.Resources>
    <Window.Styles>
        <!-- Each tab page scrolls on its own. The page is pulled 4px outwards and its content pushed back in,
             so focus rings drawn outside controls are not clipped by the scroll viewer and content stays
             aligned with the tab strip; the right margin keeps content clear of the vertical scroll bar. -->
        <Style Selector="ScrollViewer.settings-page">
            <Setter Property="Margin" Value="-4,0,0,0" />
        </Style>
        <Style Selector="ScrollViewer.settings-page > StackPanel">
            <Setter Property="Margin" Value="4,4,16,8" />
        </Style>
    </Window.Styles>

    <controls:DialogShell x:Name="Shell"
                          Title="{DynamicResource LocSettingsTitle}">
        <controls:DialogShell.Footer>
            <!-- Settings are applied live and saved on close: a single (primary) action -->
            <StackPanel Classes="dialog-actions">
                <Button Classes="accent"
                        Content="{DynamicResource LocCommonClose}"
                        IsCancel="True"
                        Click="Close_Click" />
            </StackPanel>
        </controls:DialogShell.Footer>

        <controls:CustomTabs>
            <controls:CustomTabs.Items>
                <!-- ============================== Main ============================== -->
                <controls:CustomTabItem>
                    <controls:CustomTabItem.Header>
                        <TextBlock Text="{DynamicResource LocSettingsTabMain}" />
                    </controls:CustomTabItem.Header>
                    <ScrollViewer Classes="settings-page"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Classes="section-header first" Text="{DynamicResource LocSettingsGeneral}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsTheme}">
                                <controls:SearchableComboBox ItemsSource="{Binding ThemeOptions}"
                                                             SelectedItem="{Binding Theme, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsDisplayLanguage}">
                                <controls:SearchableComboBox ItemsSource="{Binding DisplayLanguageOptions}"
                                                             DisplayMemberPath="DisplayName"
                                                             SelectedValuePath="Code"
                                                             SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}">
                                    <controls:SearchableComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="loc:LanguageOption">
                                            <TextBlock Text="{Binding DisplayName}" />
                                        </DataTemplate>
                                    </controls:SearchableComboBox.ItemTemplate>
                                </controls:SearchableComboBox>
                            </controls:LabeledField>
                            <controls:LabeledField>
                                <CheckBox Content="{DynamicResource LocSettingsRunOnStartup}"
                                          IsChecked="{Binding RunOnStartup}" />
                            </controls:LabeledField>
                            <controls:LabeledField>
                                <CheckBox Content="{DynamicResource LocSettingsAutoCheckUpdates}"
                                          IsChecked="{Binding AutoCheckForUpdates}" />
                            </controls:LabeledField>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsStorage}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsDefaultFolder}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Text="{Binding DefaultSaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource LocSettingsDefaultFolder}" />
                                    <Button Grid.Column="1"
                                            Content="{DynamicResource LocSettingsBrowse}"
                                            Command="{Binding BrowseFolderCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}" />
                                </Grid>
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsDefaultFormat}">
                                <controls:SearchableComboBox ItemsSource="{Binding FormatOptions}"
                                                             SelectedItem="{Binding DefaultFormat, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsJpegQuality}">
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                                    <Slider Classes="quality"
                                            Minimum="50"
                                            Maximum="100"
                                            VerticalAlignment="Center"
                                            Value="{Binding JpegQuality}"
                                            AutomationProperties.Name="{DynamicResource LocSettingsJpegQuality}" />
                                    <TextBlock Grid.Column="1"
                                               Classes="secondary"
                                               MinWidth="28"
                                               TextAlignment="Right"
                                               VerticalAlignment="Center"
                                               Text="{Binding JpegQuality}" />
                                </Grid>
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsFilenamePattern}">
                                <TextBox Text="{Binding FilenamePattern, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{DynamicResource LocSettingsFilenamePattern}" />
                            </controls:LabeledField>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsOcr}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsProvider}">
                                <controls:SearchableComboBox ItemsSource="{Binding OcrEngines}"
                                                             SelectedItem="{Binding OcrEngine, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsLanguages}">
                                <TextBox Text="{Binding OcrLanguages, UpdateSourceTrigger=PropertyChanged}"
                                         AutomationProperties.Name="{DynamicResource LocSettingsLanguages}" />
                            </controls:LabeledField>
                            <controls:LabeledField>
                                <StackPanel Spacing="8">
                                    <TextBlock Classes="caption" Text="{DynamicResource LocSettingsEasyOcrHint}" />
                                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                        <Button Content="{Binding EasyOcrActionLabel}"
                                                Command="{Binding ManageEasyOcrCommand}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                            <TextBlock Classes="secondary" Text="{Binding EasyOcrInstallStatus}" />
                                            <ProgressBar Minimum="0"
                                                         Maximum="100"
                                                         Value="{Binding EasyOcrInstallProgress}"
                                                         IsVisible="{Binding IsEasyOcrInstalling}" />
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </controls:LabeledField>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsTesseractFiles}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsSelectLanguage}">
                                <controls:SearchableComboBox ItemsSource="{Binding TesseractLanguages}"
                                                             DisplayMemberPath="DisplayName"
                                                             SelectedItem="{Binding SelectedTesseractLanguage, Mode=TwoWay}">
                                    <controls:SearchableComboBox.ItemTemplate>
                                        <DataTemplate x:DataType="utilities:TesseractLanguageOption">
                                            <StackPanel Orientation="Horizontal" Spacing="6">
                                                <TextBlock Text="{Binding DisplayName}" />
                                                <TextBlock Classes="secondary"
                                                           Text="{Binding Code, StringFormat=' ({0})'}" />
                                                <TextBlock Classes="success"
                                                           Text="&#x2713;"
                                                           IsVisible="{Binding IsInstalled}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </controls:SearchableComboBox.ItemTemplate>
                                </controls:SearchableComboBox>
                            </controls:LabeledField>
                            <controls:LabeledField>
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                                    <!-- Single button that changes text/action based on install state -->
                                    <Button Content="{Binding LanguageButtonText}"
                                            Command="{Binding LanguageActionCommand}"
                                            IsEnabled="{Binding IsLanguageButtonEnabled}"
                                            Classes.danger="{Binding SelectedTesseractLanguage.IsInstalled, FallbackValue=False}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                        <TextBlock Classes="secondary"
                                                   Text="{Binding SelectedTesseractLanguage.StatusText}" />
                                        <ProgressBar Minimum="0"
                                                     Maximum="100"
                                                     Value="{Binding SelectedTesseractLanguage.Progress}"
                                                     IsVisible="{Binding SelectedTesseractLanguage.IsDownloading, FallbackValue=False}" />
                                    </StackPanel>
                                </Grid>
                            </controls:LabeledField>
                        </StackPanel>
                    </ScrollViewer>
                </controls:CustomTabItem>

                <!-- ============================== Hotkeys ============================== -->
                <controls:CustomTabItem>
                    <controls:CustomTabItem.Header>
                        <TextBlock Text="{DynamicResource LocSettingsTabHotkeys}" />
                    </controls:CustomTabItem.Header>
                    <ScrollViewer Classes="settings-page"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Classes="section-header first" Text="{DynamicResource LocSettingsHotkeys}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsRegionHotkey}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding RegionHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsFullscreenHotkey}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding FullscreenHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsActiveWindowHotkey}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding ActiveWindowHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsEditorHotkeys}" />
                            <controls:LabeledField Label="{DynamicResource LocToolUndo}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding EditorUndoHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocToolRedo}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding EditorRedoHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocToolCopy}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding EditorCopyHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocToolSaveAs}">
                                <controls:SearchableComboBox CommitSelectionOnClose="True"
                                                             ItemsSource="{Binding HotkeyOptions}"
                                                             Text="{Binding EditorSaveHotkeyText, Mode=TwoWay}" />
                            </controls:LabeledField>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsEditorMouse}" />
                            <controls:LabeledField Label="{DynamicResource LocSettingsCopyCloseMouse}">
                                <controls:SearchableComboBox ItemsSource="{Binding MouseButtonOptions}"
                                                             SelectedItem="{Binding EditorCopyCloseMouseButton, Mode=TwoWay}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsMoveSelectionMouse}">
                                <controls:SearchableComboBox ItemsSource="{Binding MouseButtonOptions}"
                                                             SelectedItem="{Binding EditorMoveSelectionMouseButton, Mode=TwoWay}" />
                            </controls:LabeledField>
                        </StackPanel>
                    </ScrollViewer>
                </controls:CustomTabItem>

                <!-- ============================== Editor ============================== -->
                <controls:CustomTabItem>
                    <controls:CustomTabItem.Header>
                        <TextBlock Text="{DynamicResource LocSettingsTabEditor}" />
                    </controls:CustomTabItem.Header>
                    <ScrollViewer Classes="settings-page"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel Grid.IsSharedSizeScope="True">
                            <TextBlock Classes="section-header first" Text="{DynamicResource LocSettingsEditorIcons}" />
                            <!-- Each check box shows/hides the icon in the capture toolbar (Tag = icon preview) -->
                            <primitives:UniformGrid Columns="2">
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowUndoIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconUndo}" Content="{DynamicResource LocToolUndo}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowRedoIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconRedo}" Content="{DynamicResource LocToolRedo}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowMoveIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconMove}" Content="{DynamicResource LocToolMove}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowPenIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconPen}" Content="{DynamicResource LocToolPen}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowLineIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconLine}" Content="{DynamicResource LocToolLine}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowArrowIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconArrow}" Content="{DynamicResource LocToolArrow}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowRectangleIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconRect}" Content="{DynamicResource LocToolRect}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowEllipseIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconEllipse}" Content="{DynamicResource LocToolEllipse}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowTextIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconText}" Content="{DynamicResource LocToolText}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowHighlightIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconHighlight}" Content="{DynamicResource LocToolHighlight}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowBlurIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconBlur}" Content="{DynamicResource LocToolBlur}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowPixelateIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconPixelate}" Content="{DynamicResource LocToolPixelate}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowSaveIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconSave}" Content="{DynamicResource LocToolSaveAs}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowCopyIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconCopy}" Content="{DynamicResource LocToolCopy}" />
                                <CheckBox Classes="icon-option" IsChecked="{Binding ShowCancelIcon, Mode=TwoWay}"
                                              Tag="{StaticResource IconCancel}" Content="{DynamicResource LocToolCancel}" />
                            </primitives:UniformGrid>

                            <TextBlock Classes="section-header" Text="{DynamicResource LocSettingsEditorOptions}" />
                            <controls:LabeledField>
                                <CheckBox Content="{DynamicResource LocSettingsShowThicknessSlider}"
                                          IsChecked="{Binding EditorShowThicknessSlider}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsDefaultThickness}"
                                                   IsVisible="{Binding EditorShowThicknessSlider, Converter={StaticResource InverseBool}}">
                                <TextBox Text="{Binding EditorDefaultThickness, UpdateSourceTrigger=PropertyChanged}"
                                         Width="96"
                                         HorizontalAlignment="Left"
                                         AutomationProperties.Name="{DynamicResource LocSettingsDefaultThickness}" />
                            </controls:LabeledField>

                            <controls:LabeledField>
                                <CheckBox Content="{DynamicResource LocSettingsShowColorPalette}"
                                          IsChecked="{Binding EditorShowColorPalette}" />
                            </controls:LabeledField>
                            <controls:LabeledField Label="{DynamicResource LocSettingsDefaultColor}"
                                                   IsVisible="{Binding EditorShowColorPalette, Converter={StaticResource InverseBool}}">
                                <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="8">
                                    <Border Width="32"
                                            Height="{StaticResource ControlHeight}"
                                            CornerRadius="{StaticResource RadiusMd}"
                                            BorderBrush="{DynamicResource InputBorderBrush}"
                                            BorderThickness="1"
                                            Background="{Binding EditorDefaultColorBrush}" />
                                    <TextBox Grid.Column="1"
                                             Text="{Binding EditorDefaultColor, UpdateSourceTrigger=PropertyChanged}"
                                             AutomationProperties.Name="{DynamicResource LocSettingsDefaultColor}" />
                                    <Button x:Name="DefaultColorPickButton"
                                            Grid.Column="2"
                                            Content="{DynamicResource LocSettingsPickColor}"
                                            Click="DefaultColorPick_Click" />
                                    <primitives:Popup x:Name="DefaultColorPopup"
                                                      Placement="Bottom"
                                                      IsLightDismissEnabled="True"
                                                      PlacementTarget="{Binding ElementName=DefaultColorPickButton}">
                                        <controls:ColorPalettePicker x:Name="DefaultColorPicker"
                                                                     Color="{Binding EditorDefaultColorValue, Mode=TwoWay}"
                                                                     AlphaEnabled="True" />
                                    </primitives:Popup>
                                </Grid>
                            </controls:LabeledField>
                            <controls:LabeledField IsVisible="{Binding EditorShowColorPalette, Converter={StaticResource InverseBool}}">
                                <TextBlock Classes="caption" Text="{DynamicResource LocSettingsDefaultColorHint}" />
                            </controls:LabeledField>
                        </StackPanel>
                    </ScrollViewer>
                </controls:CustomTabItem>
            </controls:CustomTabs.Items>
        </controls:CustomTabs>
    </controls:DialogShell>
</Window>
