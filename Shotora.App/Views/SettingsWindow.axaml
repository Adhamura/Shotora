        <Geometry x:Key="IconPixelate">M200-120q-33 0-56.5-23.5T120-200v-560q0-33 23.5-56.5T200-840h200v720H200Zm280 0q-17 0-28.5-11.5T440-160q0-17 11.5-28.5T480-200q17 0 28.5 11.5T520-160q0 17-11.5 28.5T480-120Zm0-160q-17 0-28.5-11.5T440-320q0-17 11.5-28.5T480-360q17 0 28.5 11.5T520-320q0 17-11.5 28.5T480-280Zm0-160q-17 0-28.5-11.5T440-480q0-17 11.5-28.5T480-520q17 0 28.5 11.5T520-480q0 17-11.5 28.5T480-440Zm0-160q-17 0-28.5-11.5T440-640q0-17 11.5-28.5T480-680q17 0 28.5 11.5T520-640q0 17-11.5 28.5T480-600Zm0-160q-17 0-28.5-11.5T440-800q0-17 11.5-28.5T480-840q17 0 28.5 11.5T520-800q0 17-11.5 28.5T480-760Zm80 560q-17 0-28.5-11.5T520-240q0-17 11.5-28.5T560-280q17 0 28.5 11.5T600-240q0 17-11.5 28.5T560-200Zm0-160q-17 0-28.5-11.5T520-400q0-17 11.5-28.5T560-440q17 0 28.5 11.5T600-400q0 17-11.5 28.5T560-360Zm0-160q-17 0-28.5-11.5T520-560q0-17 11.5-28.5T560-600q17 0 28.5 11.5T600-560q0 17-11.5 28.5T560-520Zm0-160q-17 0-28.5-11.5T520-720q0-17 11.5-28.5T560-760q17 0 28.5 11.5T600-720q0 17-11.5 28.5T560-680Zm80 560q-17 0-28.5-11.5T600-160q0-17 11.5-28.5T640-200q17 0 28.5 11.5T680-160q0 17-11.5 28.5T640-120Zm0-160q-17 0-28.5-11.5T600-320q0-17 11.5-28.5T640-360q17 0 28.5 11.5T680-320q0 17-11.5 28.5T640-280Zm0-160q-17 0-28.5-11.5T600-480q0-17 11.5-28.5T640-520q17 0 28.5 11.5T680-480q0 17-11.5 28.5T640-440Zm0-160q-17 0-28.5-11.5T600-640q0-17 11.5-28.5T640-680q17 0 28.5 11.5T680-640q0 17-11.5 28.5T640-600Zm0-160q-17 0-28.5-11.5T600-800q0-17 11.5-28.5T640-840q17 0 28.5 11.5T680-800q0 17-11.5 28.5T640-760Zm80 560q-17 0-28.5-11.5T680-240q0-17 11.5-28.5T720-280q17 0 28.5 11.5T760-240q0 17-11.5 28.5T720-200Zm0-160q-17 0-28.5-11.5T680-400q0-17 11.5-28.5T720-440q17 0 28.5 11.5T760-400q0 17-11.5 28.5T720-360Zm0-160q-17 0-28.5-11.5T680-560q0-17 11.5-28.5T720-600q17 0 28.5 11.5T760-560q0 17-11.5 28.5T720-520Zm0-160q-17 0-28.5-11.5T680-720q0-17 11.5-28.5T720-760q17 0 28.5 11.5T760-720q0 17-11.5 28.5T720-680Zm120 300q-8 0-14-6t-6-14q0-8 6-14t14-6q8 0 14 6t6 14q0 8-6 14t-14 6Zm0-160q-8 0-14-6t-6-14q0-8 6-14t14-6q8 0 14 6t6 14q0 8-6 14t-14 6Z</Geometry>
    </Window.Resources>
    <Window.Styles>
        <Style Selector="ToggleButton.editor-circle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Opacity" Value="0.65" />
            <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="x:Object">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Path Data="{Binding .}"
                                  Fill="{DynamicResource IconBrush}"
                                  Stroke="{DynamicResource IconBrush}"
                                  Stretch="Uniform"
                                  StrokeThickness="0" />
                        </Viewbox>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Grid Width="{TemplateBinding Width}"
                          Height="{TemplateBinding Height}"
                          UseLayoutRounding="True">
                        <Ellipse x:Name="PART_EditorCircle"
                                 Fill="{TemplateBinding Background}"
                                 Stroke="{TemplateBinding BorderBrush}"
                                 StrokeThickness="1" />
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                    </Grid>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.editor-circle:pointerover /template/ Ellipse#PART_EditorCircle">
            <Setter Property="Fill" Value="{DynamicResource ButtonHoverBrush}" />
        </Style>
        <Style Selector="ToggleButton.editor-circle:pressed /template/ Ellipse#PART_EditorCircle">
            <Setter Property="Fill" Value="{DynamicResource ButtonPressedBrush}" />
        </Style>
        <Style Selector="ToggleButton.editor-circle:checked">
            <Setter Property="Opacity" Value="1" />
        </Style>
        <Style Selector="ToggleButton.editor-circle:checked /template/ Ellipse#PART_EditorCircle">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryDarkBrush}" />
        </Style>
        <Style Selector="ToggleButton.editor-circle:checked:pointerover /template/ Ellipse#PART_EditorCircle">
            <Setter Property="Fill" Value="{DynamicResource AccentPrimaryDarkBrush}" />
        </Style>
    </Window.Styles>
    <Border Background="{DynamicResource PanelBackgroundBrush}"
            BorderBrush="{DynamicResource PanelBorderBrush}"
            BorderThickness="1"
            CornerRadius="10"
            Padding="14"
            PointerPressed="ShellBorder_OnPointerPressed"
            PointerMoved="ShellBorder_OnPointerMoved"
            PointerExited="ShellBorder_OnPointerLeave">
        <Grid RowDefinitions="Auto,*,Auto">
            <DockPanel Margin="0,0,0,12">
                <TextBlock Text="{DynamicResource LocSettingsTitle}"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
            </DockPanel>

            <controls:CustomTabs Grid.Row="1">
                <controls:CustomTabs.Items>
                    <controls:CustomTabItem>
                        <controls:CustomTabItem.Header>
                            <TextBlock Text="{DynamicResource LocSettingsTabMain}" />
                        </controls:CustomTabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LocSettingsGeneral}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsTheme}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding ThemeOptions}"
                                                                 SelectedItem="{Binding Theme, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsDisplayLanguage}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding DisplayLanguageOptions}"
                                                                 DisplayMemberPath="DisplayName"
                                                                 SelectedValuePath="Code"
                                                                 SelectedValue="{Binding DisplayLanguage, Mode=TwoWay}">
                                        <controls:SearchableComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="loc:LanguageOption">
                                                <TextBlock Text="{Binding DisplayName}" />
                                            </DataTemplate>
                                        </controls:SearchableComboBox.ItemTemplate>
                                    </controls:SearchableComboBox>
                                </StackPanel>
                                <CheckBox Content="{DynamicResource LocSettingsRunOnStartup}"
                                          IsChecked="{Binding RunOnStartup}"
                                          Margin="20,6,0,0" />

                                <TextBlock Text="{DynamicResource LocSettingsStorage}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsDefaultFolder}" Width="140"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding DefaultSaveFolder, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240"
                                             Margin="0,0,6,0" />
                                    <Button Content="{DynamicResource LocSettingsBrowse}"
                                            Command="{Binding BrowseFolderCommand}"
                                            CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=Window}}"
                                            Width="90"
                                            Height="25"
                                            Classes="rounded-action" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsDefaultFormat}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding FormatOptions}"
                                                                 SelectedItem="{Binding DefaultFormat, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0" VerticalAlignment="Center">
                                    <TextBlock Text="{DynamicResource LocSettingsJpegQuality}" Width="140"
                                               VerticalAlignment="Center" />
                                    <Slider Minimum="50" Maximum="100" Width="220" Value="{Binding JpegQuality}"
                                            Classes="quality" />
                                    <TextBlock Text="{Binding JpegQuality}" Margin="10,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                </StackPanel>

                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsFilenamePattern}" Width="140"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding FilenamePattern, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" Height="28" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LocSettingsOcr}" FontWeight="Medium" FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsProvider}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding OcrEngines}"
                                                                 SelectedItem="{Binding OcrEngine, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsLanguages}" Width="140"
                                               VerticalAlignment="Center" />
                                    <TextBox Text="{Binding OcrLanguages, UpdateSourceTrigger=PropertyChanged}"
                                             Width="240" Height="28" />
                                </StackPanel>
                                <TextBlock Text="{DynamicResource LocSettingsEasyOcrHint}"
                                           FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}"
                                           Margin="20,4,0,0" TextWrapping="Wrap" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0" VerticalAlignment="Center">
                                    <Button Content="{Binding EasyOcrActionLabel}"
                                            Width="100"
                                            Height="25"
                                            Classes="rounded-action"
                                            Command="{Binding ManageEasyOcrCommand}" />
                                    <TextBlock Text="{Binding EasyOcrInstallStatus}"
                                               Margin="8,0,0,0"
                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                               VerticalAlignment="Center" />
                                    <ProgressBar Minimum="0" Maximum="100" Height="24" Width="240"
                                                 Margin="8,0,0,0"
                                                 Value="{Binding EasyOcrInstallProgress}"
                                                 IsVisible="{Binding IsEasyOcrInstalling}" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LocSettingsTesseractFiles}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsSelectLanguage}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding TesseractLanguages}"
                                                                 DisplayMemberPath="DisplayName"
                                                                 SelectedItem="{Binding SelectedTesseractLanguage, Mode=TwoWay}">
                                        <controls:SearchableComboBox.ItemTemplate>
                                            <DataTemplate x:DataType="utilities:TesseractLanguageOption">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding DisplayName}" />
                                                    <TextBlock Text="{Binding Code, StringFormat=' ({0})'}"
                                                               Foreground="{DynamicResource TextSecondaryBrush}"
                                                               Margin="6,0,0,0" />
                                                    <TextBlock Text="&#x2713;" Foreground="Lime" Margin="8,0,0,0"
                                                               IsVisible="{Binding IsInstalled}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </controls:SearchableComboBox.ItemTemplate>
                                    </controls:SearchableComboBox>
                                </StackPanel>
                                <Grid Margin="20,10,0,0" VerticalAlignment="Center"
                                      ColumnDefinitions="Auto,20,*,Auto">
                                    <!-- Single button that changes text/action based on install state -->
                                    <Button Content="{Binding LanguageButtonText}"
                                            Width="120"
                                            Height="28"
                                            Command="{Binding LanguageActionCommand}"
                                            IsEnabled="{Binding IsLanguageButtonEnabled}"
                                            Classes="rounded-action" />

                                    <ProgressBar Grid.Column="2"
                                                 Minimum="0" Maximum="100" Height="28" Width="260"
                                                 Value="{Binding SelectedTesseractLanguage.Progress}"
                                                 VerticalAlignment="Center"
                                                 IsVisible="{Binding SelectedTesseractLanguage.IsDownloading}" />
                                    <TextBlock Grid.Column="3"
                                               Text="{Binding SelectedTesseractLanguage.StatusText}"
                                               Margin="8,0,0,0"
                                               VerticalAlignment="Center" />
                                </Grid>
                            </StackPanel>
                        </ScrollViewer>
                    </controls:CustomTabItem>
                    <controls:CustomTabItem>
                        <controls:CustomTabItem.Header>
                            <TextBlock Text="{DynamicResource LocSettingsTabHotkeys}" />
                        </controls:CustomTabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LocSettingsHotkeys}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsRegionHotkey}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding RegionHotkeyText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsFullscreenHotkey}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding FullscreenHotkeyText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsActiveWindowHotkey}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding ActiveWindowHotkeyText, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LocSettingsEditorHotkeys}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocToolUndo}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding EditorUndoHotkeyText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocToolRedo}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding EditorRedoHotkeyText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocToolCopy}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding EditorCopyHotkeyText, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocToolSaveAs}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 CommitSelectionOnClose="True"
                                                                 ItemsSource="{Binding HotkeyOptions}"
                                                                 Text="{Binding EditorSaveHotkeyText, Mode=TwoWay}" />
                                </StackPanel>

                                <TextBlock Text="{DynamicResource LocSettingsEditorMouse}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <StackPanel Orientation="Horizontal" Margin="20,4,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsCopyCloseMouse}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding MouseButtonOptions}"
                                                                 SelectedItem="{Binding EditorCopyCloseMouseButton, Mode=TwoWay}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0">
                                    <TextBlock Text="{DynamicResource LocSettingsMoveSelectionMouse}" Width="140"
                                               VerticalAlignment="Center" />
                                    <controls:SearchableComboBox Width="240"
                                                                 ItemsSource="{Binding MouseButtonOptions}"
                                                                 SelectedItem="{Binding EditorMoveSelectionMouseButton, Mode=TwoWay}" />
                                </StackPanel>
                            </StackPanel>
                        </ScrollViewer>
                    </controls:CustomTabItem>

                    <controls:CustomTabItem>
                        <controls:CustomTabItem.Header>
                            <TextBlock Text="{DynamicResource LocSettingsTabEditor}" />
                        </controls:CustomTabItem.Header>
                        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto">
                            <StackPanel>
                                <TextBlock Text="{DynamicResource LocSettingsEditorIcons}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,12,0,0" />
                                <primitives:UniformGrid Margin="20,8,0,0" Columns="2">
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowUndoIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconUndo}" />
                                        <TextBlock Text="{DynamicResource LocToolUndo}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowRedoIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconRedo}" />
                                        <TextBlock Text="{DynamicResource LocToolRedo}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowMoveIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconMove}" />
                                        <TextBlock Text="{DynamicResource LocToolMove}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowPenIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconPen}" />
                                        <TextBlock Text="{DynamicResource LocToolPen}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowLineIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconLine}" />
                                        <TextBlock Text="{DynamicResource LocToolLine}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowArrowIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconArrow}" />
                                        <TextBlock Text="{DynamicResource LocToolArrow}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowRectangleIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconRect}" />
                                        <TextBlock Text="{DynamicResource LocToolRect}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowEllipseIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconEllipse}" />
                                        <TextBlock Text="{DynamicResource LocToolEllipse}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowTextIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconText}" />
                                        <TextBlock Text="{DynamicResource LocToolText}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowHighlightIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconHighlight}" />
                                        <TextBlock Text="{DynamicResource LocToolHighlight}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowBlurIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconBlur}" />
                                        <TextBlock Text="{DynamicResource LocToolBlur}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowPixelateIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconPixelate}" />
                                        <TextBlock Text="{DynamicResource LocToolPixelate}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowSaveIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconSave}" />
                                        <TextBlock Text="{DynamicResource LocToolSaveAs}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowCopyIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconCopy}" />
                                        <TextBlock Text="{DynamicResource LocToolCopy}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <StackPanel Orientation="Horizontal" Margin="0,0,18,12">
                                        <ToggleButton Classes="editor-circle"
                                                      IsChecked="{Binding ShowCancelIcon, Mode=TwoWay}"
                                                      Content="{StaticResource IconCancel}" />
                                        <TextBlock Text="{DynamicResource LocToolCancel}" Margin="10,0,0,0"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </primitives:UniformGrid>
                                <TextBlock Text="{DynamicResource LocSettingsEditorOptions}" FontWeight="Medium"
                                           FontSize="16"
                                           Margin="0,14,0,0" />
                                <CheckBox Content="{DynamicResource LocSettingsShowThicknessSlider}"
                                          Margin="20,6,0,0"
                                          IsChecked="{Binding EditorShowThicknessSlider}" />
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0"
                                            IsVisible="{Binding EditorShowThicknessSlider, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="{DynamicResource LocSettingsDefaultThickness}" Width="140"
                                               VerticalAlignment="Center" />
                                    <TextBox
                                        Text="{Binding EditorDefaultThickness, UpdateSourceTrigger=PropertyChanged}"
                                        Width="80" Height="28" />
                                </StackPanel>

                                <CheckBox Content="{DynamicResource LocSettingsShowColorPalette}" Margin="20,10,0,0"
                                          IsChecked="{Binding EditorShowColorPalette}" />
                                <StackPanel Orientation="Horizontal" Margin="20,6,0,0"
                                            IsVisible="{Binding EditorShowColorPalette, Converter={StaticResource InverseBool}}">
                                    <TextBlock Text="{DynamicResource LocSettingsDefaultColor}" Width="140"
                                               VerticalAlignment="Center" />
                                    <Border Width="40" Height="22" CornerRadius="3"
                                            BorderBrush="{DynamicResource PanelBorderBrush}" BorderThickness="1"
                                            Background="{Binding EditorDefaultColorBrush}" VerticalAlignment="Center" />
                                    <TextBox Text="{Binding EditorDefaultColor, UpdateSourceTrigger=PropertyChanged}"
                                             Width="120" Height="28" Margin="10,0,0,0" />
                                    <Button x:Name="DefaultColorPickButton"
                                            Content="{DynamicResource LocSettingsPickColor}"
                                            Width="70" Margin="8,0,0,0"
                                            Height="25"
                                            Classes="rounded-action"
                                            Click="DefaultColorPick_Click" />
                                    <primitives:Popup x:Name="DefaultColorPopup" Placement="Bottom"
                                                      IsLightDismissEnabled="True"
                                                      PlacementTarget="{Binding ElementName=DefaultColorPickButton}">
                                        <controls:ColorPalettePicker x:Name="DefaultColorPicker"
                                                                     Color="{Binding EditorDefaultColorValue, Mode=TwoWay}"
                                                                     AlphaEnabled="True" />
                                    </primitives:Popup>
                                </StackPanel>
                                <TextBlock Text="{DynamicResource LocSettingsDefaultColorHint}" Margin="20,4,0,0"
                                           Foreground="{DynamicResource TextSecondaryBrush}" FontSize="12"
                                           TextWrapping="Wrap" />
                            </StackPanel>
                        </ScrollViewer>
                    </controls:CustomTabItem>
                </controls:CustomTabs.Items>
            </controls:CustomTabs>

            <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
                <Button Content="{DynamicResource LocCommonClose}" Width="90"
                        Height="25"
                        Click="Close_Click"
                        Classes="rounded-action" />
            </StackPanel>
        </Grid>
    </Border>
</Window>