<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        x:Class="Shotora.App.Views.TextInputWindow"
        Width="520"
        MinWidth="400"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Title="{DynamicResource LocTextInputTitle}"
        SystemDecorations="None"
        Background="Transparent"
        TransparencyLevelHint="Transparent">
    <Design.DataContext>
        <x:String>Design</x:String>
    </Design.DataContext>

    <controls:DialogShell Title="{DynamicResource LocTextInputTitle}">
        <controls:DialogShell.Footer>
            <StackPanel Classes="dialog-actions">
                <Button Content="{DynamicResource LocTextInputCancel}"
                        IsCancel="True"
                        Click="Cancel_Click" />
                <Button Classes="accent"
                        Content="{DynamicResource LocTextInputPlace}"
                        IsDefault="True"
                        Click="Ok_Click" />
            </StackPanel>
        </controls:DialogShell.Footer>

        <StackPanel Spacing="12">
            <!-- Enter inserts a new line; Ctrl+Enter places the text (see code-behind) -->
            <TextBox x:Name="TextBox"
                     AcceptsReturn="True"
                     TextWrapping="Wrap"
                     MinHeight="112"
                     MaxHeight="240"
                     Watermark="{DynamicResource LocTextInputHint}"
                     AutomationProperties.Name="{DynamicResource LocTextInputHint}" />

            <Grid ColumnDefinitions="*,96,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4">
                    <TextBlock Text="{DynamicResource LocTextInputFont}" />
                    <controls:SearchableComboBox x:Name="FontFamilyBox" />
                </StackPanel>

                <StackPanel Grid.Column="1" Spacing="4">
                    <TextBlock Text="{DynamicResource LocTextInputSize}" />
                    <TextBox x:Name="FontSizeBox"
                             Text="16"
                             AutomationProperties.Name="{DynamicResource LocTextInputSize}" />
                </StackPanel>

                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Bottom"
                            Spacing="4">
                    <ToggleButton x:Name="BoldToggle"
                                  Classes="toggle"
                                  FontWeight="Bold"
                                  ToolTip.Tip="{DynamicResource LocTextInputBold}"
                                  Content="{DynamicResource LocTextInputBold}" />
                    <ToggleButton x:Name="ItalicToggle"
                                  Classes="toggle"
                                  FontStyle="Italic"
                                  ToolTip.Tip="{DynamicResource LocTextInputItalic}"
                                  Content="{DynamicResource LocTextInputItalic}" />
                </StackPanel>
            </Grid>

            <!-- Live preview of the text with the chosen font settings -->
            <Border Classes="card" MinHeight="56" Padding="12,8">
                <TextBlock x:Name="PreviewText"
                           TextWrapping="Wrap"
                           MaxHeight="120"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </Border>
        </StackPanel>
    </controls:DialogShell>
</Window>
