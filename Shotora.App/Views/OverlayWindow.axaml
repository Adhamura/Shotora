<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        xmlns:primitives="clr-namespace:Avalonia.Controls.Primitives;assembly=Avalonia.Controls"
        x:Class="Shotora.App.Views.OverlayWindow"
        Width="800"
        Height="600"
        SystemDecorations="None"
        CanResize="False"
        TransparencyLevelHint="Transparent"
        Background="Transparent"
        WindowStartupLocation="Manual"
        Topmost="True"
        KeyDown="OnKeyDown">
    <Window.Styles>
        <Style Selector="Thumb.handle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased">
            <Path x:Name="DimmerPath"
                  Fill="{DynamicResource OverlayMaskBrush}"
                  IsHitTestVisible="False" />
            <Border x:Name="SelectionBorder"
                    BorderBrush="{DynamicResource SelectionBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    IsVisible="False" />
            <Canvas x:Name="HandleCanvas" IsVisible="False">
                <Thumb x:Name="HandleNw" Tag="NW" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopLeftCorner" />
                <Thumb x:Name="HandleN" Tag="N" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopSide" />
                <Thumb x:Name="HandleNe" Tag="NE" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopRightCorner" />
                <Thumb x:Name="HandleE" Tag="E" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="RightSide" />
                <Thumb x:Name="HandleSe" Tag="SE" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomRightCorner" />
                <Thumb x:Name="HandleS" Tag="S" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomSide" />
                <Thumb x:Name="HandleSw" Tag="SW" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomLeftCorner" />
                <Thumb x:Name="HandleW" Tag="W" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="LeftSide" />
            </Canvas>
            <!-- Annotation Canvas for completed annotations -->
            <Canvas x:Name="AnnotationCanvas" IsVisible="True" />
            <!-- Preview Canvas for current drawing operation -->
            <Canvas x:Name="PreviewCanvas" IsVisible="True" />
        </Canvas>

        <!-- Editor toolbar: wraps onto more rows when the screen is narrower than the toolbar -->
        <Border Classes="floating-panel"
                HorizontalAlignment="Center"
                VerticalAlignment="Bottom"
                Margin="12,12,12,16">
            <WrapPanel Orientation="Horizontal" HorizontalAlignment="Center" ItemsAlignment="Center">
                <ToggleButton x:Name="PointerButton" Classes="tool" Tag="Pointer" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocOverlayPointer}"
                              AutomationProperties.Name="{DynamicResource LocOverlayPointer}"
                              Content="{StaticResource IconSelect}" />
                <ToggleButton x:Name="SelectionButton" Classes="tool" Tag="Selection" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolRegion}"
                              AutomationProperties.Name="{DynamicResource LocToolRegion}"
                              Content="{StaticResource IconRegion}" />
                <Button x:Name="UndoButton" Classes="tool" IsEnabled="False"
                        ToolTip.Tip="{DynamicResource LocToolUndo}"
                        AutomationProperties.Name="{DynamicResource LocToolUndo}"
                        Content="{StaticResource IconUndo}" />
                <Button x:Name="RedoButton" Classes="tool" IsEnabled="False"
                        ToolTip.Tip="{DynamicResource LocToolRedo}"
                        AutomationProperties.Name="{DynamicResource LocToolRedo}"
                        Content="{StaticResource IconRedo}" />
                <ToggleButton x:Name="MoveButton" Classes="tool" Tag="Move" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolMove}"
                              AutomationProperties.Name="{DynamicResource LocToolMove}"
                              Content="{StaticResource IconMove}" />
                <ToggleButton x:Name="PenButton" Classes="tool" Tag="Pen" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolPen}"
                              AutomationProperties.Name="{DynamicResource LocToolPen}"
                              Content="{StaticResource IconPen}" />
                <ToggleButton x:Name="LineButton" Classes="tool" Tag="Line" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolLine}"
                              AutomationProperties.Name="{DynamicResource LocToolLine}"
                              Content="{StaticResource IconLine}" />
                <ToggleButton x:Name="ArrowButton" Classes="tool" Tag="Arrow" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolArrow}"
                              AutomationProperties.Name="{DynamicResource LocToolArrow}"
                              Content="{StaticResource IconArrow}" />
                <ToggleButton x:Name="RectangleButton" Classes="tool" Tag="Rectangle" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolRect}"
                              AutomationProperties.Name="{DynamicResource LocToolRect}"
                              Content="{StaticResource IconRect}" />
                <ToggleButton x:Name="EllipseButton" Classes="tool" Tag="Ellipse" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolEllipse}"
                              AutomationProperties.Name="{DynamicResource LocToolEllipse}"
                              Content="{StaticResource IconEllipse}" />
                <ToggleButton x:Name="TextButton" Classes="tool" Tag="Text" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolText}"
                              AutomationProperties.Name="{DynamicResource LocToolText}"
                              Content="{StaticResource IconText}" />
                <ToggleButton x:Name="HighlightButton" Classes="tool" Tag="Highlight" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolHighlight}"
                              AutomationProperties.Name="{DynamicResource LocToolHighlight}"
                              Content="{StaticResource IconHighlight}" />
                <ToggleButton x:Name="BlurButton" Classes="tool" Tag="Blur" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolBlur}"
                              AutomationProperties.Name="{DynamicResource LocToolBlur}"
                              Content="{StaticResource IconBlur}" />
                <ToggleButton x:Name="PixelateButton" Classes="tool" Tag="Pixelate" IsCheckedChanged="OnToolChecked"
                              ToolTip.Tip="{DynamicResource LocToolPixelate}"
                              AutomationProperties.Name="{DynamicResource LocToolPixelate}"
                              Content="{StaticResource IconPixelate}" />
                <!-- Output actions group; the divider hides when every output action is hidden in Settings -->
                <Border Classes="toolbar-separator">
                    <Border.IsVisible>
                        <MultiBinding Converter="{x:Static BoolConverters.Or}">
                            <Binding Path="IsVisible" ElementName="SaveButton" />
                            <Binding Path="IsVisible" ElementName="CopyButton" />
                            <Binding Path="IsVisible" ElementName="CancelButton" />
                        </MultiBinding>
                    </Border.IsVisible>
                </Border>
                <Button x:Name="SaveButton" Classes="tool" Click="OnSaveClicked"
                        ToolTip.Tip="{DynamicResource LocToolSaveAs}"
                        AutomationProperties.Name="{DynamicResource LocToolSaveAs}"
                        Content="{StaticResource IconSave}" />
                <Button x:Name="CopyButton" Classes="tool accent" Click="OnCopyClicked"
                        ToolTip.Tip="{DynamicResource LocToolCopy}"
                        AutomationProperties.Name="{DynamicResource LocToolCopy}"
                        Content="{StaticResource IconCopy}" />
                <Button x:Name="CancelButton" Classes="tool" Click="OnCancelClicked"
                        ToolTip.Tip="{DynamicResource LocToolCancel}"
                        AutomationProperties.Name="{DynamicResource LocToolCancel}"
                        Content="{StaticResource IconCancel}" />
            </WrapPanel>
        </Border>

        <!-- Pointer position + selection size; hidden until the first pointer update fills it in -->
        <Border Classes="floating-panel"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Margin="12"
                Padding="8,4"
                CornerRadius="{StaticResource RadiusMd}"
                IsHitTestVisible="False"
                IsVisible="{Binding #CoordinateLabel.Text, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
            <TextBlock x:Name="CoordinateLabel"
                       FontSize="{StaticResource FontSizeCaption}"
                       Text="" />
        </Border>

        <!-- Color Palette Panel (Right Side, draggable) -->
        <StackPanel x:Name="ColorsPanel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="12"
                    PointerPressed="ColorsPanel_OnPointerPressed"
                    PointerMoved="ColorsPanel_OnPointerMoved"
                    PointerReleased="ColorsPanel_OnPointerReleased">
            <Border Classes="floating-panel" Padding="12" MaxWidth="264">
                <StackPanel Spacing="8">
                    <TextBlock Classes="label" Text="{DynamicResource LocToolColors}" />

                    <!-- Thickness Slider -->
                    <Grid x:Name="ThicknessPanel" ColumnDefinitions="Auto,*" ColumnSpacing="8">
                        <TextBlock Text="{DynamicResource LocToolThickness}" VerticalAlignment="Center" />
                        <Slider x:Name="ThicknessSlider" Grid.Column="1" Minimum="1" Maximum="12" MinWidth="96" Value="6"
                                Classes="quality"
                                AutomationProperties.Name="{DynamicResource LocToolThickness}"
                                ValueChanged="ThicknessSlider_OnValueChanged" />
                    </Grid>

                    <!-- Quick Color Swatches -->
                    <WrapPanel x:Name="ColorPalette" />

                    <!-- Color Picker Button + Popup -->
                    <Panel HorizontalAlignment="Left">
                        <Button x:Name="ColorPickerButton" Classes="tool"
                                Margin="0"
                                ToolTip.Tip="{DynamicResource LocOverlayPickColor}"
                                AutomationProperties.Name="{DynamicResource LocOverlayPickColor}"
                                Click="ColorPickerToggle_Click"
                                Content="{StaticResource IconPalette}" />
                        <primitives:Popup x:Name="ColorPopup" Placement="Left" IsLightDismissEnabled="True"
                                          PlacementTarget="{Binding ElementName=ColorPickerButton}">
                            <controls:ColorPalettePicker x:Name="ColorPicker"
                                                         ColorChanged="ColorPicker_OnColorChanged"
                                                         AlphaEnabled="True" />
                        </primitives:Popup>
                    </Panel>
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>