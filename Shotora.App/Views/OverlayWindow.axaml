        <Geometry x:Key="IconSave">M160-80v-80h640v80H160Zm320-160L200-600h160v-280h240v280h160L480-240Zm0-130 116-150h-76v-280h-80v280h-76l116 150Zm0-150Z</Geometry>
        <Geometry x:Key="IconCopy">M360-240q-33 0-56.5-23.5T280-320v-480q0-33 23.5-56.5T360-880h360q33 0 56.5 23.5T800-800v480q0 33-23.5 56.5T720-240H360Zm0-80h360v-480H360v480ZM200-80q-33 0-56.5-23.5T120-160v-560h80v560h440v80H200Zm160-240v-480 480Z</Geometry>
        <Geometry x:Key="IconCancel">m256-200-56-56 224-224-224-224 56-56 224 224 224-224 56 56-224 224 224 224-56 56-224-224-224 224Z</Geometry>
    </Window.Resources>

    <Window.Styles>
        <Style Selector="ToggleButton.circle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="x:Object">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Path Data="{Binding .}"
                                  Fill="{DynamicResource IconBrush}"
                                  Stroke="{DynamicResource IconBrush}"
                                  Stretch="Uniform"
                                  StrokeThickness="0" />
                        </Viewbox>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            CornerRadius="20"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="ToggleButton.circle:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryDarkBrush}" />
        </Style>
        <Style Selector="ToggleButton.circle:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.circle:checked /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        </Style>
        <Style Selector="ToggleButton.circle:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Button.circle">
            <Setter Property="Width" Value="40" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Margin" Value="4" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryDarkBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="ContentTemplate">
                <Setter.Value>
                    <DataTemplate x:DataType="x:Object">
                        <Viewbox Width="20" Height="20" Stretch="Uniform">
                            <Path Data="{Binding .}"
                                  Fill="{DynamicResource IconBrush}"
                                  Stroke="{DynamicResource IconBrush}"
                                  Stretch="Uniform"
                                  StrokeThickness="0" />
                        </Viewbox>
                    </DataTemplate>
                </Setter.Value>
            </Setter>
            <Setter Property="Template">
                <ControlTemplate>
                    <Border x:Name="PART_Border"
                            CornerRadius="20"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalAlignment="Center"
                                          VerticalAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                </ControlTemplate>
            </Setter>
        </Style>
        <Style Selector="Button.circle:pointerover /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentPrimaryDarkBrush}" />
        </Style>
        <Style Selector="Button.circle:pressed /template/ Border#PART_Border">
            <Setter Property="Background" Value="{DynamicResource AccentSecondaryBrush}" />
        </Style>
        <Style Selector="Button.circle:disabled">
            <Setter Property="Opacity" Value="0.4" />
        </Style>

        <Style Selector="Thumb.handle">
            <Setter Property="Width" Value="12" />
            <Setter Property="Height" Value="12" />
            <Setter Property="Background" Value="White" />
            <Setter Property="BorderBrush" Value="{DynamicResource SelectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
        </Style>
    </Window.Styles>

    <Grid>
        <Image x:Name="BackgroundImage" Stretch="Fill" />
        <Canvas x:Name="OverlayCanvas"
                Background="Transparent"
                PointerPressed="OnPointerPressed"
                PointerMoved="OnPointerMoved"
                PointerReleased="OnPointerReleased">
            <Path x:Name="DimmerPath"
                  Fill="{DynamicResource OverlayMaskBrush}"
                  IsHitTestVisible="False" />
            <Border x:Name="SelectionBorder"
                    BorderBrush="{DynamicResource SelectionBorderBrush}"
                    BorderThickness="2"
                    CornerRadius="2"
                    Background="Transparent"
                    IsHitTestVisible="False"
                    IsVisible="False" />
            <Canvas x:Name="HandleCanvas" IsVisible="False">
                <Thumb x:Name="HandleNw" Tag="NW" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopLeftCorner" />
                <Thumb x:Name="HandleN" Tag="N" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopSide" />
                <Thumb x:Name="HandleNe" Tag="NE" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="TopRightCorner" />
                <Thumb x:Name="HandleE" Tag="E" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="RightSide" />
                <Thumb x:Name="HandleSe" Tag="SE" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomRightCorner" />
                <Thumb x:Name="HandleS" Tag="S" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomSide" />
                <Thumb x:Name="HandleSw" Tag="SW" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="BottomLeftCorner" />
                <Thumb x:Name="HandleW" Tag="W" Classes="handle"
                       DragStarted="OnHandleDragStarted"
                       DragDelta="OnHandleDragDelta"
                       DragCompleted="OnHandleDragCompleted"
                       Cursor="LeftSide" />
            </Canvas>
            <!-- Annotation Canvas for completed annotations -->
            <Canvas x:Name="AnnotationCanvas" IsVisible="True" />
            <!-- Preview Canvas for current drawing operation -->
            <Canvas x:Name="PreviewCanvas" IsVisible="True" />
        </Canvas>

        <Border HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,12"
                Background="{DynamicResource PanelAltBackgroundBrush}"
                BorderBrush="{DynamicResource PanelBorderBrush}"
                BorderThickness="1"
                CornerRadius="12"
                Padding="10">
            <StackPanel Orientation="Horizontal">
                <ToggleButton x:Name="PointerButton" Classes="circle" Tag="Pointer" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconSelect}" />
                <ToggleButton x:Name="SelectionButton" Classes="circle" Tag="Selection"
                              IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconRegion}" />
                <Button x:Name="UndoButton" Classes="circle" IsEnabled="False"
                        Content="{StaticResource IconUndo}" />
                <Button x:Name="RedoButton" Classes="circle" IsEnabled="False"
                        Content="{StaticResource IconRedo}" />
                <ToggleButton x:Name="MoveButton" Classes="circle" Tag="Move" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconMove}" />
                <ToggleButton x:Name="PenButton" Classes="circle" Tag="Pen" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconPen}" />
                <ToggleButton x:Name="LineButton" Classes="circle" Tag="Line" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconLine}" />
                <ToggleButton x:Name="ArrowButton" Classes="circle" Tag="Arrow" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconArrow}" />
                <ToggleButton x:Name="RectangleButton" Classes="circle" Tag="Rectangle"
                              IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconRect}" />
                <ToggleButton x:Name="EllipseButton" Classes="circle" Tag="Ellipse" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconEllipse}" />
                <ToggleButton x:Name="TextButton" Classes="circle" Tag="Text" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconText}" />
                <ToggleButton x:Name="HighlightButton" Classes="circle" Tag="Highlight"
                              IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconHighlight}" />
                <ToggleButton x:Name="BlurButton" Classes="circle" Tag="Blur" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconBlur}" />
                <ToggleButton x:Name="PixelateButton" Classes="circle" Tag="Pixelate" IsCheckedChanged="OnToolChecked"
                              Content="{StaticResource IconPixelate}" />
                <Button x:Name="SaveButton" Classes="circle" Click="OnSaveClicked"
                        Content="{StaticResource IconSave}" />
                <Button x:Name="CopyButton" Classes="circle" Click="OnCopyClicked"
                        Content="{StaticResource IconCopy}" />
                <Button x:Name="CancelButton" Classes="circle" Click="OnCancelClicked"
                        Content="{StaticResource IconCancel}" />
            </StackPanel>
        </Border>

        <Border HorizontalAlignment="Left" VerticalAlignment="Top" Margin="12"
                Background="{DynamicResource PanelAltBackgroundBrush}"
                Padding="6"
                CornerRadius="6">
            <TextBlock x:Name="CoordinateLabel"
                       Foreground="{DynamicResource TextPrimaryBrush}"
                       Text="(0,0) 0x0" />
        </Border>

        <!-- Color Palette Panel (Right Side) -->
        <StackPanel x:Name="ColorsPanel" Orientation="Vertical" VerticalAlignment="Center" HorizontalAlignment="Right"
                    Margin="12"
                    PointerPressed="ColorsPanel_OnPointerPressed"
                    PointerMoved="ColorsPanel_OnPointerMoved"
                    PointerReleased="ColorsPanel_OnPointerReleased">
            <Border Background="{DynamicResource PanelAltBackgroundBrush}"
                    BorderBrush="{DynamicResource PanelBorderBrush}"
                    BorderThickness="1"
                    Padding="8"
                    CornerRadius="6">
                <StackPanel>
                    <TextBlock Text="{DynamicResource LocToolColors}" Foreground="{DynamicResource TextPrimaryBrush}"
                               Margin="0,0,0,6" />

                    <!-- Thickness Slider -->
                    <StackPanel x:Name="ThicknessPanel" Orientation="Horizontal" Margin="0,0,0,8">
                        <TextBlock Text="{DynamicResource LocToolThickness}" VerticalAlignment="Center"
                                   Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,6,0" />
                        <Slider x:Name="ThicknessSlider" Minimum="1" Maximum="12" Width="100" Value="6"
                                Classes="quality"
                                ValueChanged="ThicknessSlider_OnValueChanged" />
                    </StackPanel>

                    <!-- Color Picker Button -->
                    <Button x:Name="ColorPickerButton" Classes="circle"
                            ToolTip.Tip="More colors" Click="ColorPickerToggle_Click" HorizontalAlignment="Left"
                            Content="{StaticResource IconPalette}" />

                    <!-- Color Picker Popup -->
                    <primitives:Popup x:Name="ColorPopup" Placement="Left" IsLightDismissEnabled="True"
                                      PlacementTarget="{Binding ElementName=ColorPickerButton}">
                        <controls:ColorPalettePicker x:Name="ColorPicker"
                                                     ColorChanged="ColorPicker_OnColorChanged"
                                                     AlphaEnabled="True" />
                    </primitives:Popup>

                    <!-- Quick Color Swatches -->
                    <WrapPanel x:Name="ColorPalette" ItemWidth="26" ItemHeight="26" Margin="0,8,0,0" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Grid>
</Window>