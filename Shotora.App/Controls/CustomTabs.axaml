<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="clr-namespace:Shotora.App.Controls"
             x:Class="Shotora.App.Controls.CustomTabs"
             x:Name="Root">
    <Grid RowDefinitions="Auto,*">
        <!-- Tab strip: underline tabs that wrap onto a second line for long translations -->
        <Border BorderBrush="{DynamicResource DividerBrush}"
                BorderThickness="0,0,0,1">
            <ListBox x:Name="TabsList"
                     ItemsSource="{Binding Items, ElementName=Root}"
                     SelectedIndex="{Binding SelectedIndex, ElementName=Root, Mode=TwoWay}"
                     SelectionMode="Single"
                     Background="Transparent"
                     BorderThickness="0"
                     Padding="0"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.Styles>
                    <Style Selector="ListBoxItem">
                        <Setter Property="Margin" Value="0,0,4,0" />
                        <Setter Property="Padding" Value="12,8" />
                        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
                        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
                        <Setter Property="Cursor" Value="Hand" />
                        <Setter Property="FocusAdorner" Value="{x:Null}" />
                        <Setter Property="Template">
                            <ControlTemplate>
                                <Panel>
                                    <Border x:Name="TabHost"
                                            Background="Transparent"
                                            CornerRadius="6,6,0,0"
                                            Padding="{TemplateBinding Padding}">
                                        <ContentPresenter Content="{TemplateBinding Content}"
                                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                                          Foreground="{TemplateBinding Foreground}"
                                                          HorizontalAlignment="Center"
                                                          VerticalAlignment="Center" />
                                    </Border>
                                    <Border x:Name="Indicator"
                                            Height="3"
                                            CornerRadius="2"
                                            VerticalAlignment="Bottom"
                                            Margin="8,0"
                                            Background="Transparent" />
                                    <Border x:Name="FocusRing"
                                            CornerRadius="6,6,0,0"
                                            BorderBrush="{DynamicResource FocusRingBrush}"
                                            BorderThickness="{StaticResource FocusRingThickness}"
                                            IsHitTestVisible="False"
                                            IsVisible="False" />
                                </Panel>
                            </ControlTemplate>
                        </Setter>
                    </Style>
                    <Style Selector="ListBoxItem TextBlock">
                        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover /template/ Border#TabHost">
                        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:pointerover">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:pressed /template/ Border#TabHost">
                        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected">
                        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:selected /template/ Border#Indicator">
                        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
                    </Style>
                    <Style Selector="ListBoxItem:focus-visible /template/ Border#FocusRing">
                        <Setter Property="IsVisible" Value="True" />
                    </Style>
                </ListBox.Styles>
                <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="controls:CustomTabItem">
                        <ContentPresenter Content="{Binding Header}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <ContentPresenter Grid.Row="1"
                          Margin="0,12,0,0"
                          Content="{Binding SelectedContent, ElementName=Root}"
                          DataContext="{Binding DataContext, ElementName=Root}" />
    </Grid>
</UserControl>
