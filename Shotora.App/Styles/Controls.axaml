<!--
    Shotora design system: theme-independent tokens and shared control styles.
    Colour brushes live in Theme.axaml / LightTheme.axaml / SunsetTheme.axaml (always via DynamicResource);
    sizes, spacing, radii and typography live here (via StaticResource).
    See docs/design/DESIGN_SYSTEM.md for the full reference.
-->
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:Shotora.App.Controls"
        x:Class="Shotora.App.Styles.Controls">
    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceInclude Source="avares://Shotora.App/Styles/Icons.axaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- Spacing scale (4 / 8 / 12 / 16 / 24) -->
            <x:Double x:Key="SpaceXs">4</x:Double>
            <x:Double x:Key="SpaceSm">8</x:Double>
            <x:Double x:Key="SpaceMd">12</x:Double>
            <x:Double x:Key="SpaceLg">16</x:Double>
            <x:Double x:Key="SpaceXl">24</x:Double>

            <!-- Corner radii -->
            <CornerRadius x:Key="RadiusSm">4</CornerRadius>
            <CornerRadius x:Key="RadiusMd">6</CornerRadius>
            <CornerRadius x:Key="RadiusLg">8</CornerRadius>
            <CornerRadius x:Key="RadiusXl">12</CornerRadius>

            <!-- Typography scale -->
            <x:Double x:Key="FontSizeCaption">12</x:Double>
            <x:Double x:Key="FontSizeBody">14</x:Double>
            <x:Double x:Key="FontSizeSubtitle">15</x:Double>
            <x:Double x:Key="FontSizeTitle">18</x:Double>
            <x:Double x:Key="FontSizeDisplay">24</x:Double>

            <!-- Control metrics -->
            <x:Double x:Key="ControlHeight">32</x:Double>
            <x:Double x:Key="ButtonMinWidth">96</x:Double>
            <x:Double x:Key="IconButtonSize">32</x:Double>
            <x:Double x:Key="ToolButtonSize">40</x:Double>
            <x:Double x:Key="FormLabelMaxWidth">220</x:Double>
            <x:Double x:Key="FormFieldMaxWidth">380</x:Double>
            <Thickness x:Key="ButtonPadding">16,6</Thickness>
            <Thickness x:Key="InputPadding">10,6</Thickness>
            <Thickness x:Key="FocusRingThickness">2</Thickness>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ===================================================================== -->
    <!-- Base: windows and text                                                -->
    <!-- ===================================================================== -->
    <Style Selector="Window">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>
    <Style Selector="TextBlock.title">
        <Setter Property="FontSize" Value="{StaticResource FontSizeTitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style Selector="TextBlock.display">
        <Setter Property="FontSize" Value="{StaticResource FontSizeDisplay}" />
    </Style>
    <Style Selector="TextBlock.section-header">
        <Setter Property="FontSize" Value="{StaticResource FontSizeSubtitle}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="Margin" Value="0,16,0,8" />
    </Style>
    <Style Selector="TextBlock.section-header.first">
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.secondary">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.caption">
        <Setter Property="FontSize" Value="{StaticResource FontSizeCaption}" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style Selector="TextBlock.success">
        <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Dialog shell (Controls/DialogShell.cs)                                -->
    <!-- ===================================================================== -->
    <Style Selector="controls|DialogShell">
        <Setter Property="Background" Value="{DynamicResource PanelBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="16,12,16,0" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border x:Name="PART_Shell"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}"
                        ClipToBounds="True">
                    <Grid RowDefinitions="Auto,*,Auto">
                        <!-- Title bar: drag area + title + close button -->
                        <Grid x:Name="PART_TitleBar"
                              ColumnDefinitions="*,Auto"
                              Background="Transparent"
                              Margin="16,12,10,0"
                              MinHeight="{StaticResource IconButtonSize}">
                            <StackPanel VerticalAlignment="Center" Spacing="2">
                                <TextBlock Classes="title"
                                           Text="{TemplateBinding Title}" />
                                <TextBlock Classes="secondary"
                                           Text="{TemplateBinding Subtitle}"
                                           IsVisible="{TemplateBinding Subtitle, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                            <Button x:Name="PART_CloseButton"
                                    Grid.Column="1"
                                    Classes="icon subtle"
                                    VerticalAlignment="Top"
                                    Margin="8,0,0,0"
                                    IsVisible="{TemplateBinding ShowCloseButton}"
                                    KeyboardNavigation.IsTabStop="False"
                                    ToolTip.Tip="{DynamicResource LocCommonClose}"
                                    AutomationProperties.Name="{DynamicResource LocCommonClose}"
                                    Content="{StaticResource IconCancel}" />
                        </Grid>

                        <ContentPresenter x:Name="PART_ContentPresenter"
                                          Grid.Row="1"
                                          Margin="{TemplateBinding Padding}"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch" />

                        <!-- Footer: right-aligned actions, primary action last -->
                        <ContentPresenter x:Name="PART_FooterPresenter"
                                          Grid.Row="2"
                                          Margin="16,16,16,16"
                                          Content="{TemplateBinding Footer}"
                                          IsVisible="{TemplateBinding Footer, Converter={x:Static ObjectConverters.IsNotNull}}" />
                    </Grid>
                </Border>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- Footer action row used inside DialogShell.Footer -->
    <Style Selector="StackPanel.dialog-actions">
        <Setter Property="Orientation" Value="Horizontal" />
        <Setter Property="HorizontalAlignment" Value="Right" />
        <Setter Property="Spacing" Value="{StaticResource SpaceSm}" />
    </Style>
    <Style Selector="StackPanel.dialog-actions > Button">
        <Setter Property="MinWidth" Value="{StaticResource ButtonMinWidth}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Form layout (Controls/LabeledField.cs)                                -->
    <!-- Put Grid.IsSharedSizeScope="True" on the container so labels align.  -->
    <!-- ===================================================================== -->
    <Style Selector="controls|LabeledField">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" SharedSizeGroup="FormLabel" />
                        <ColumnDefinition Width="*" MaxWidth="{StaticResource FormFieldMaxWidth}" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Name="PART_Label"
                               Text="{TemplateBinding Label}"
                               TextWrapping="Wrap"
                               MaxWidth="{StaticResource FormLabelMaxWidth}"
                               Margin="0,0,16,0"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                      VerticalAlignment="Center" />
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>

    <!-- ===================================================================== -->
    <!-- Card surface                                                          -->
    <!-- ===================================================================== -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="Border.floating-panel">
        <Setter Property="Background" Value="{DynamicResource PanelAltBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusXl}" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- ===================================================================== -->
    <!-- TextBox                                                               -->
    <!-- ===================================================================== -->
    <Style Selector="TextBox">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource InputPadding}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="CaretBrush" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="SelectionForegroundBrush" Value="{DynamicResource AccentForegroundBrush}" />
        <Setter Property="InnerRightContent" Value="{x:Null}" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Disabled" />
    </Style>
    <!-- Multi-line inputs must be able to scroll long content -->
    <Style Selector="TextBox[AcceptsReturn=True]">
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>
    <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderHoverBrush}" />
    </Style>
    <Style Selector="TextBox:pointerover">
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
    </Style>
    <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource InputBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>
    <Style Selector="TextBox:focus">
        <Setter Property="Foreground" Value="{DynamicResource InputForegroundBrush}" />
    </Style>
    <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement">
        <Setter Property="Background" Value="{DynamicResource ButtonDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
    </Style>
    <Style Selector="TextBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>
    <Style Selector="TextBox /template/ TextBlock#PART_Watermark, TextBox /template/ TextBlock#PART_FloatingWatermark">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Button                                                                -->
    <!-- Default (no class) = secondary. Classes: accent | danger | subtle |   -->
    <!-- icon (square, icon-only; combine with subtle) | menu-item | swatch.   -->
    <!-- ===================================================================== -->
    <Style Selector="Button">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="FontSize" Value="{StaticResource FontSizeBody}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="{StaticResource ButtonPadding}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <!-- Geometry content renders as an icon; anything else uses the default template -->
                <controls:IconContentTemplate />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter x:Name="PART_Content"
                                          Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Foreground="{TemplateBinding Foreground}"
                                          FontFamily="{TemplateBinding FontFamily}"
                                          FontSize="{TemplateBinding FontSize}"
                                          FontWeight="{TemplateBinding FontWeight}" />
                    </Border>
                    <Border x:Name="PART_FocusRing"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector="Button:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
    </Style>
    <Style Selector="Button:disabled /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource ButtonDisabledBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonDisabledBrush}" />
    </Style>
    <Style Selector="Button:disabled">
        <Setter Property="Foreground" Value="{DynamicResource ButtonDisabledForegroundBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- Primary action: at most one per dialog, placed last (right-most) in the footer -->
    <Style Selector="Button.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.accent:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.accent:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" />
    </Style>

    <!-- Destructive action -->
    <Style Selector="Button.danger">
        <Setter Property="Foreground" Value="{DynamicResource DangerForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource DangerBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource DangerBrush}" />
    </Style>
    <Style Selector="Button.danger:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource DangerHoverBrush}" />
    </Style>
    <Style Selector="Button.danger:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource DangerPressedBrush}" />
    </Style>

    <!-- Subtle / ghost: no chrome until hovered -->
    <Style Selector="Button.subtle">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.subtle:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.subtle:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>
    <Style Selector="Button.subtle:disabled /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>

    <!-- Square icon-only button (always give it ToolTip.Tip + AutomationProperties.Name) -->
    <Style Selector="Button.icon">
        <Setter Property="Width" Value="{StaticResource IconButtonSize}" />
        <Setter Property="Height" Value="{StaticResource IconButtonSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Padding" Value="8" />
    </Style>

    <!-- Tray menu entries (created in TrayMenuWindowService) -->
    <Style Selector="Button.menu-item">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="MinWidth" Value="180" />
    </Style>
    <Style Selector="Button.menu-item /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="Button.menu-item:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>
    <Style Selector="Button.menu-item:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>

    <!-- Colour swatch (overlay quick palette) -->
    <Style Selector="Button.swatch">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>
    <Style Selector="Button.swatch:pointerover /template/ Border#PART_ButtonBorder, Button.swatch:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{Binding $parent[Button].Background}" />
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>

    <!-- HyperlinkButton: inline links (About window) -->
    <Style Selector="HyperlinkButton">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
        <Setter Property="Padding" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="HorizontalAlignment" Value="Left" />
    </Style>
    <Style Selector="HyperlinkButton /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="HyperlinkButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, HyperlinkButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource LinkHoverBrush}" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style Selector="HyperlinkButton:visited /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Foreground" Value="{DynamicResource LinkBrush}" />
    </Style>
    <Style Selector="HyperlinkButton:focus-visible /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="BorderThickness" Value="{StaticResource FocusRingThickness}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusSm}" />
    </Style>
    <Style Selector="HyperlinkButton TextBlock">
        <Setter Property="TextDecorations" Value="Underline" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!-- ===================================================================== -->
    <!-- ToggleButton                                                          -->
    <!-- ===================================================================== -->
    <Style Selector="ToggleButton">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
    </Style>

    <!-- Two-state text toggle (e.g. Bold / Italic) -->
    <Style Selector="ToggleButton.toggle">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="MinWidth" Value="{StaticResource ControlHeight}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="Foreground" Value="{DynamicResource ButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource ButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Center"
                                          VerticalContentAlignment="Center"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Border x:Name="PART_FocusRing"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.toggle:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource ButtonHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.toggle:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource ButtonPressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.toggle:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.toggle:checked /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryDarkBrush}" />
    </Style>
    <Style Selector="ToggleButton.toggle:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="ToggleButton.toggle:disabled">
        <Setter Property="Opacity" Value="0.5" />
    </Style>

    <!-- Settings > Editor: "show this icon" option. Content = label, Tag = icon Geometry. -->
    <Style Selector="ToggleButton.icon-option">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="6" />
        <Setter Property="Margin" Value="0,0,8,4" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_Row"
                            Background="{TemplateBinding Background}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Padding="{TemplateBinding Padding}">
                        <Grid ColumnDefinitions="Auto,*">
                            <Panel Width="{StaticResource ToolButtonSize}" Height="{StaticResource ToolButtonSize}">
                                <Ellipse x:Name="PART_Circle"
                                         Fill="{DynamicResource ButtonBackgroundBrush}"
                                         Stroke="{DynamicResource ButtonBorderBrush}"
                                         StrokeThickness="1" />
                                <Viewbox Width="20" Height="20" Stretch="Uniform">
                                    <Path x:Name="PART_Icon"
                                          Data="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}, DataType=ToggleButton}"
                                          Fill="{DynamicResource IconBrush}"
                                          Stretch="Uniform" />
                                </Viewbox>
                            </Panel>
                            <ContentPresenter Grid.Column="1"
                                              Margin="12,0,0,0"
                                              VerticalAlignment="Center"
                                              Content="{TemplateBinding Content}"
                                              Foreground="{TemplateBinding Foreground}">
                                <ContentPresenter.DataTemplates>
                                    <DataTemplate DataType="x:String">
                                        <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                                    </DataTemplate>
                                </ContentPresenter.DataTemplates>
                            </ContentPresenter>
                        </Grid>
                    </Border>
                    <Border x:Name="PART_FocusRing"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ToggleButton.icon-option:pointerover /template/ Border#PART_Row">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon-option:pressed /template/ Border#PART_Row">
        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon-option:unchecked /template/ Panel > Ellipse#PART_Circle, ToggleButton.icon-option:unchecked /template/ Viewbox">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="ToggleButton.icon-option:unchecked">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondaryBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon-option:checked /template/ Ellipse#PART_Circle">
        <Setter Property="Fill" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Stroke" Value="{DynamicResource AccentPrimaryDarkBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon-option:checked /template/ Path#PART_Icon">
        <Setter Property="Fill" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.icon-option:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Editor toolbar (OverlayWindow): round tool buttons                    -->
    <!-- Content = icon Geometry. Always set ToolTip.Tip.                      -->
    <!-- ===================================================================== -->
    <Style Selector="Button.tool, ToggleButton.tool">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Width" Value="{StaticResource ToolButtonSize}" />
        <Setter Property="Height" Value="{StaticResource ToolButtonSize}" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Padding" Value="10" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource IconBrush}" />
        <Setter Property="CornerRadius" Value="20" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="ContentTemplate">
            <Setter.Value>
                <controls:IconContentTemplate />
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <ControlTemplate>
                <Panel>
                    <Border x:Name="PART_ButtonBorder"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{TemplateBinding CornerRadius}">
                        <ContentPresenter Content="{TemplateBinding Content}"
                                          ContentTemplate="{TemplateBinding ContentTemplate}"
                                          Padding="{TemplateBinding Padding}"
                                          HorizontalContentAlignment="Stretch"
                                          VerticalContentAlignment="Stretch"
                                          Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <Border x:Name="PART_FocusRing"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            BorderBrush="{DynamicResource FocusRingBrush}"
                            BorderThickness="{StaticResource FocusRingThickness}"
                            IsHitTestVisible="False"
                            IsVisible="False" />
                </Panel>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Button.tool:pointerover /template/ Border#PART_ButtonBorder, ToggleButton.tool:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PanelBorderBrush}" />
    </Style>
    <Style Selector="Button.tool:pressed /template/ Border#PART_ButtonBorder, ToggleButton.tool:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource SubtlePressedBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked">
        <Setter Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
    </Style>
    <Style Selector="ToggleButton.tool:checked /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryDarkBrush}" />
    </Style>
    <Style Selector="Button.tool.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentButtonForegroundBrush}" />
        <Setter Property="Background" Value="{DynamicResource AccentButtonBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentButtonBorderBrush}" />
    </Style>
    <Style Selector="Button.tool.accent:pointerover /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentButtonHoverBrush}" />
    </Style>
    <Style Selector="Button.tool.accent:pressed /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="{DynamicResource AccentButtonPressedBrush}" />
    </Style>
    <Style Selector="Button.tool:disabled, ToggleButton.tool:disabled">
        <Setter Property="Opacity" Value="0.35" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>
    <Style Selector="Button.tool:disabled /template/ Border#PART_ButtonBorder">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="Transparent" />
    </Style>
    <Style Selector="Button.tool:focus-visible /template/ Border#PART_FocusRing, ToggleButton.tool:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="Border.toolbar-separator">
        <Setter Property="Width" Value="1" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Margin" Value="6,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Background" Value="{DynamicResource DividerBrush}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- CheckBox                                                              -->
    <!-- ===================================================================== -->
    <Style Selector="CheckBox">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="{StaticResource ControlHeight}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <ControlTemplate>
                <Grid ColumnDefinitions="Auto,*" Background="Transparent" VerticalAlignment="Center">
                    <Panel Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                        <Border x:Name="Box"
                                Background="{DynamicResource InputBackgroundBrush}"
                                BorderBrush="{DynamicResource InputBorderBrush}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource RadiusSm}" />
                        <Path x:Name="CheckMark"
                              Data="M 3.5 9 L 7.5 13 L 14.5 5"
                              Stroke="{DynamicResource AccentForegroundBrush}"
                              StrokeThickness="2"
                              IsVisible="False" />
                        <Border x:Name="PART_FocusRing"
                                Margin="-3"
                                CornerRadius="6"
                                BorderBrush="{DynamicResource FocusRingBrush}"
                                BorderThickness="{StaticResource FocusRingThickness}"
                                IsHitTestVisible="False"
                                IsVisible="False" />
                    </Panel>
                    <ContentPresenter Grid.Column="1"
                                      Content="{TemplateBinding Content}"
                                      ContentTemplate="{TemplateBinding ContentTemplate}"
                                      Foreground="{TemplateBinding Foreground}"
                                      FontFamily="{TemplateBinding FontFamily}"
                                      FontSize="{TemplateBinding FontSize}"
                                      FontWeight="{TemplateBinding FontWeight}"
                                      VerticalAlignment="Center">
                        <ContentPresenter.DataTemplates>
                            <DataTemplate DataType="x:String">
                                <TextBlock Text="{Binding}" TextWrapping="Wrap" />
                            </DataTemplate>
                        </ContentPresenter.DataTemplates>
                    </ContentPresenter>
                </Grid>
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="CheckBox:checked /template/ Border#Box">
        <Setter Property="Background" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:checked /template/ Path#CheckMark">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox:pointerover /template/ Border#Box">
        <Setter Property="BorderBrush" Value="{DynamicResource AccentPrimaryBrush}" />
    </Style>
    <Style Selector="CheckBox:focus-visible /template/ Border#PART_FocusRing">
        <Setter Property="IsVisible" Value="True" />
    </Style>
    <Style Selector="CheckBox:disabled /template/ Border#Box">
        <Setter Property="Opacity" Value="0.5" />
    </Style>
    <Style Selector="CheckBox:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
        <Setter Property="Cursor" Value="Arrow" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Slider / ProgressBar                                                  -->
    <!-- ===================================================================== -->
    <Style Selector="Slider.quality">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
        <Setter Property="Background" Value="{DynamicResource SliderTrackBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource SliderFillBrush}" />
    </Style>
    <Style Selector="Slider.quality:disabled">
        <Setter Property="Opacity" Value="0.55" />
    </Style>
    <Style Selector="Slider.quality /template/ Thumb">
        <Setter Property="Width" Value="16" />
        <Setter Property="Height" Value="16" />
        <Setter Property="Background" Value="{DynamicResource SliderThumbBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SliderThumbBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="Slider.quality:focus-visible /template/ Thumb">
        <Setter Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style Selector="Slider.quality:disabled /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource SliderDisabledThumbBrush}" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource SliderTrackBrush}" />
        <Setter Property="MinHeight" Value="6" />
        <Setter Property="Height" Value="6" />
        <Setter Property="CornerRadius" Value="3" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!-- ===================================================================== -->
    <!-- ScrollBar                                                             -->
    <!-- ===================================================================== -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="{DynamicResource ScrollBarBackgroundBrush}" />
    </Style>
    <Style Selector="ScrollBar:vertical">
        <Setter Property="Width" Value="12" />
    </Style>
    <Style Selector="ScrollBar:horizontal">
        <Setter Property="Height" Value="12" />
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbBrush}" />
        <Setter Property="Template">
            <ControlTemplate>
                <Border Background="{TemplateBinding Background}"
                        CornerRadius="6" />
            </ControlTemplate>
        </Setter>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb:pointerover">
        <Setter Property="Background" Value="{DynamicResource ScrollBarThumbHoverBrush}" />
    </Style>
    <Style Selector="ScrollBar:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- ===================================================================== -->
    <!-- Context menus (e.g. TextBox cut/copy/paste)                           -->
    <!-- ===================================================================== -->
    <Style Selector="ContextMenu">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="MenuItem">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Padding" Value="10,6" />
    </Style>
    <Style Selector="MenuItem:pointerover /template/ Border#PART_LayoutRoot">
        <Setter Property="Background" Value="{DynamicResource SubtleHoverBrush}" />
    </Style>
    <Style Selector="MenuItem:disabled">
        <Setter Property="Foreground" Value="{DynamicResource TextDisabledBrush}" />
    </Style>

    <!-- ===================================================================== -->
    <!-- ToolTip                                                               -->
    <!-- ===================================================================== -->
    <Style Selector="ToolTip">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
        <Setter Property="Background" Value="{DynamicResource PopupBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource PopupBorderBrush}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
    </Style>
</Styles>
